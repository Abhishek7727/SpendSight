# ==============================================================================
# SpendSight (Welth) - Environment Configuration
# Built with ❤️ by Abhishek Namdev
# ==============================================================================

# Clerk Authentication (Client-side)
# Get your publishable key from: https://dashboard.clerk.com -> API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Supabase Backend (Client-side)
# Get your Project URL and anon public key from: https://supabase.com/dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here

# Google Gemini API Key (Client-side for AI Receipt Scanner, Voice Logging & Spending Assistant)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Supabase Edge Functions Secrets (Set in Supabase Dashboard -> Edge Functions -> Secrets)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL="SpendSight <onboarding@resend.dev>"
# GEMINI_API_KEY=your_gemini_api_key_here (same as EXPO_PUBLIC_GEMINI_API_KEY)
# EMAIL_LOGO_URL=https://your-public-cdn.com/logo.png (optional)
